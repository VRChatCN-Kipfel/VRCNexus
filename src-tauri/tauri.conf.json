{
  "$schema": "../frontend/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VRCNexus",
  "version": "0.1.0",
  "identifier": "cn.lyric.vrcnexus",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:4040",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "VRCNexus",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
